{
  "name": "Pix Api Data Review App",
  "env": {
    "REVIEW_APP": {
      "description": "Indicates that the application is a review app",
      "value": "true"
    }
  },
  "scripts": {
    "first-deploy": "npm run postdeploy && npm run db:seed"
  },
  "addons": [
    {
      "plan": "postgresql:postgresql-sandbox",
      "options": {
        "version": "16.3"
      }
    }
  ],
  "formation": {
    "web": {
      "amount": 1,
      "size": "S"
    }
  },
  "stack": "scalingo-22"
}
